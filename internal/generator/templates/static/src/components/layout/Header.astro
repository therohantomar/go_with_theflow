---
import Button from "../Button.astro";
import site from "../../content/site.json";
const s = site.style;
const loud = s === "bold" || s === "creative";
---
<header class="sticky top-0 z-30 border-b border-primary/10 bg-surface/95 backdrop-blur">
  {s === "editorial" ? (
    <div class="relative mx-auto max-w-7xl px-6 py-5 text-center">
      <a href="#" class="font-heading text-xl uppercase tracking-[0.25em] text-primary md:text-2xl md:tracking-[0.3em]">{site.name}</a>
      <nav class="mt-3 hidden justify-center gap-8 text-[11px] uppercase tracking-[0.25em] md:flex">
        {site.nav.map((n) => <a href={`#${n.id}`} class="hover:text-secondary">{n.label}</a>)}
      </nav>
      <button data-menu-btn type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu"
        class="group absolute right-4 top-1/2 flex h-10 w-10 -translate-y-1/2 flex-col items-center justify-center gap-1.5 md:hidden">
        <span class="h-0.5 w-6 bg-primary transition group-aria-expanded:translate-y-2 group-aria-expanded:rotate-45"></span>
        <span class="h-0.5 w-6 bg-primary transition group-aria-expanded:opacity-0"></span>
        <span class="h-0.5 w-6 bg-primary transition group-aria-expanded:-translate-y-2 group-aria-expanded:-rotate-45"></span>
      </button>
    </div>
  ) : (
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-4">
      <a href="#" class={`font-heading text-lg font-bold text-primary md:text-xl ${loud ? "uppercase tracking-tight" : ""}`}>{site.name}</a>
      <nav class={`hidden gap-6 md:flex ${loud ? "text-xs uppercase tracking-wider" : "text-sm capitalize"}`}>
        {site.nav.map((n) => <a href={`#${n.id}`} class="hover:text-secondary">{n.label}</a>)}
      </nav>
      <div class="flex items-center gap-3">
        {site.ctas[0] && <div class="hidden sm:block"><Button {...site.ctas[0]} /></div>}
        <button data-menu-btn type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu"
          class="group flex h-10 w-10 flex-col items-center justify-center gap-1.5 md:hidden">
          <span class="h-0.5 w-6 bg-primary transition group-aria-expanded:translate-y-2 group-aria-expanded:rotate-45"></span>
          <span class="h-0.5 w-6 bg-primary transition group-aria-expanded:opacity-0"></span>
          <span class="h-0.5 w-6 bg-primary transition group-aria-expanded:-translate-y-2 group-aria-expanded:-rotate-45"></span>
        </button>
      </div>
    </div>
  )}

  <div id="mobile-menu" data-menu class="hidden max-h-[calc(100vh-4.5rem)] overflow-y-auto border-t border-primary/10 bg-surface md:hidden">
    <nav class="flex flex-col px-6 py-2">
      {site.nav.map((n) => (
        <a href={`#${n.id}`} class="border-b border-primary/10 py-4 text-base capitalize hover:text-secondary">{n.label}</a>
      ))}
    </nav>
    <div class="flex flex-col gap-3 px-6 py-5 [&_a]:w-full [&_a]:text-center">
      {site.ctas.map((c) => <Button {...c} />)}
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-menu-btn]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  if (btn && menu) {
    const setOpen = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      menu.classList.toggle("hidden", !open);
    };
    btn.addEventListener("click", () => setOpen(btn.getAttribute("aria-expanded") !== "true"));
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") setOpen(false); });
    window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => { if (e.matches) setOpen(false); });
  }
</script>
