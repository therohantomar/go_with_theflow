---
import Img from "../Img.astro";
import Carousel from "../Carousel.astro";
const { data, layout = "cards" } = Astro.props;
---
<section id="testimonials" class="px-6 py-20">
  <div class="mx-auto max-w-6xl">
    <h2 data-reveal class="mb-10 text-3xl font-bold md:text-4xl">{data.title}</h2>
    {layout === "cards" && (
      <div data-reveal class="grid gap-6 md:grid-cols-3">
        {data.items.map((t) => (
          <blockquote class="rounded-card border border-primary/10 p-6">
            <p class="text-muted">“{t.quote}”</p>
            <footer class="mt-6 flex items-center gap-3">
              <Img section="testimonials" file={t.image} class="h-10 w-10 rounded-full" />
              <div><p class="text-sm font-semibold">{t.name}</p><p class="text-xs text-muted">{t.role}</p></div>
            </footer>
          </blockquote>
        ))}
      </div>
    )}
    {layout === "carousel" && (
      <div data-reveal>
        <Carousel>
          {data.items.map((t) => (
            <blockquote class="w-full shrink-0 snap-start rounded-card bg-tertiary p-8 md:w-[calc(50%-12px)]">
              <p class="text-lg text-muted">“{t.quote}”</p>
              <footer class="mt-6 flex items-center gap-3">
                <Img section="testimonials" file={t.image} class="h-10 w-10 rounded-full" />
                <div><p class="text-sm font-semibold">{t.name}</p><p class="text-xs text-muted">{t.role}</p></div>
              </footer>
            </blockquote>
          ))}
        </Carousel>
      </div>
    )}
  </div>
</section>
