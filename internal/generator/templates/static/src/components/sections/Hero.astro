---
import Img from "../Img.astro";
import Button from "../Button.astro";
import site from "../../content/site.json";
const { data, layout = "split" } = Astro.props;
---
<section id="hero" data-hero class="relative overflow-hidden">
  {layout === "split" && (
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-24 md:grid-cols-2">
      <div>
        <p data-hero-item class="mb-3 text-sm font-semibold uppercase tracking-widest text-secondary">{data.eyebrow}</p>
        <h1 data-hero-item class="text-4xl font-bold leading-tight md:text-6xl">{data.headline}</h1>
        <p data-hero-item class="mt-6 text-lg text-muted">{data.subheadline}</p>
        <div data-hero-item class="mt-8 flex flex-wrap gap-3">{site.ctas.map((c) => <Button {...c} />)}</div>
      </div>
      <Img eager section="hero" file={data.image} class="aspect-[4/3] w-full rounded-card" />
    </div>
  )}
  {layout === "centered" && (
    <div class="mx-auto max-w-3xl px-6 py-28 text-center">
      <p data-hero-item class="mb-3 text-sm font-semibold uppercase tracking-widest text-secondary">{data.eyebrow}</p>
      <h1 data-hero-item class="text-4xl font-bold leading-tight md:text-6xl">{data.headline}</h1>
      <p data-hero-item class="mt-6 text-lg text-muted">{data.subheadline}</p>
      <div data-hero-item class="mt-8 flex flex-wrap justify-center gap-3">{site.ctas.map((c) => <Button {...c} />)}</div>
    </div>
  )}
  {layout === "background" && (
    <div class="relative flex min-h-[80vh] items-center">
      <Img eager sizes="100vw" section="hero" file={data.image} class="absolute inset-0 h-full w-full" />
      <div class="absolute inset-0 bg-black/60"></div>
      <div class="relative mx-auto max-w-3xl px-6 text-center text-white">
        <h1 data-hero-item class="text-4xl font-bold leading-tight !text-white md:text-6xl">{data.headline}</h1>
        <p data-hero-item class="mt-6 text-lg text-white/85">{data.subheadline}</p>
        <div data-hero-item class="mt-8 flex flex-wrap justify-center gap-3">{site.ctas.map((c) => <Button {...c} />)}</div>
      </div>
    </div>
  )}
  {layout === "giant" && (
    <div class="relative mx-auto max-w-7xl px-6 pb-16 pt-16 md:pt-24">
      <div class="pointer-events-none absolute -top-24 right-0 h-96 w-96 rounded-full bg-secondary/25 blur-3xl"></div>
      <p data-hero-item class="relative mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-secondary">{data.eyebrow}</p>
      <h1 data-hero-item class="relative max-w-5xl">{data.headline}</h1>
      <div class="relative mt-10 grid items-end gap-8 md:grid-cols-[1fr_auto]">
        <p data-hero-item class="max-w-xl text-lg text-muted">{data.subheadline}</p>
        <div data-hero-item class="flex flex-wrap gap-3">{site.ctas.map((c) => <Button {...c} />)}</div>
      </div>
      <Img eager section="hero" file={data.image} class="mt-14 aspect-[21/9] w-full rounded-card" />
    </div>
  )}
  {layout === "editorial" && (
    <div class="grid min-h-[88vh] md:grid-cols-[3fr_2fr]">
      <Img eager section="hero" file={data.image} class="h-full min-h-[60vh] w-full" />
      <div class="flex flex-col justify-end gap-6 p-8 md:p-14">
        <p data-hero-item class="text-[11px] uppercase tracking-[0.3em] text-muted">{data.eyebrow}</p>
        <h1 data-hero-item>{data.headline}</h1>
        <p data-hero-item class="text-sm text-muted">{data.subheadline}</p>
        <div data-hero-item class="flex gap-8 text-[11px] uppercase tracking-[0.25em]">
          {site.ctas.map((c) => <a href={c.href} class="border-b border-ink pb-1 hover:text-secondary hover:border-secondary">{c.label}</a>)}
        </div>
      </div>
    </div>
  )}
  {layout === "banner" && (
    <div class="bg-primary text-on-primary">
      <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-20 md:grid-cols-2">
        <div>
          <p data-hero-item class="mb-3 text-sm font-semibold uppercase tracking-widest text-secondary">{data.eyebrow}</p>
          <h1 data-hero-item class="!text-on-primary">{data.headline}</h1>
          <p data-hero-item class="mt-6 text-lg text-on-primary/80">{data.subheadline}</p>
          <div data-hero-item class="mt-8 flex flex-wrap gap-3">
            {site.ctas.map((c, i) => (
              <a href={c.href} class={`px-6 py-3 text-sm font-semibold rounded-btn ${i === 0 ? "bg-secondary text-on-secondary" : "border border-on-primary/40 text-on-primary"}`}>{c.label}</a>
            ))}
          </div>
        </div>
        <Img eager section="hero" file={data.image} class="aspect-[4/3] w-full rounded-card" />
      </div>
      <ul class="mx-auto grid max-w-7xl border-t border-on-primary/20 md:grid-cols-3">
        {data.points.map((p) => <li class="px-6 py-5 text-sm font-semibold uppercase tracking-wider text-on-primary/90"><span class="mr-2 text-secondary">■</span>{p}</li>)}
      </ul>
    </div>
  )}
</section>
