---
const { data, layout = "accordion" } = Astro.props;
---
<section id="faq" class="bg-tertiary px-6 py-20">
  <div class="mx-auto max-w-4xl">
    <h2 data-reveal class="mb-10 text-3xl font-bold md:text-4xl">{data.title}</h2>
    {layout === "accordion" && (
      <div data-reveal class="space-y-3">
        {data.items.map((f) => (
          <details class="group rounded-xl bg-white p-5">
            <summary class="cursor-pointer font-semibold text-primary">{f.q}</summary>
            <p class="mt-3 text-sm text-neutral-600">{f.a}</p>
          </details>
        ))}
      </div>
    )}
    {layout === "two-column" && (
      <div data-reveal class="grid gap-8 md:grid-cols-2">
        {data.items.map((f) => (
          <div><h3 class="font-semibold text-primary">{f.q}</h3><p class="mt-2 text-sm text-neutral-600">{f.a}</p></div>
        ))}
      </div>
    )}
  </div>
</section>
