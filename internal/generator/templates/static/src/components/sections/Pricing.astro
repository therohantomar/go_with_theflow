---
import site from "../../content/site.json";
const { data, layout = "cards" } = Astro.props;
const href = site.ctas[0]?.href ?? "#";
const btn = (t) => `rounded-btn px-6 py-3 text-center text-sm font-semibold ${t.highlighted ? "bg-secondary text-on-secondary" : "border border-primary text-primary hover:bg-primary hover:text-on-primary"}`;
---
<section id="pricing" class="px-6">
  <div class="mx-auto max-w-6xl">
    <div data-reveal class="mx-auto mb-12 max-w-2xl text-center">
      <h2 class="text-3xl font-bold md:text-4xl">{data.title}</h2>
      <p class="mt-3 text-muted">{data.subtitle}</p>
    </div>
    {layout === "cards" && (
      <div data-reveal class="grid gap-6 md:grid-cols-3">
        {data.items.map((t) => (
          <div class={`flex flex-col rounded-card p-8 ${t.highlighted ? "border-2 border-secondary bg-tertiary" : "border border-primary/10"}`}>
            <h3 class="text-lg font-semibold">{t.name}</h3>
            <p class="mt-4"><span class="font-heading text-4xl font-bold text-primary">{t.price}</span><span class="text-sm text-muted">{t.period}</span></p>
            <ul class="mt-6 flex-1 space-y-2 text-sm text-muted">
              {t.features.map((f) => <li><span class="mr-2 text-secondary">✓</span>{f}</li>)}
            </ul>
            <a href={href} class={`mt-8 ${btn(t)}`}>{t.cta}</a>
          </div>
        ))}
      </div>
    )}
    {layout === "list" && (
      <div data-reveal class="divide-y divide-primary/10 border-y border-primary/10">
        {data.items.map((t) => (
          <div class="flex flex-col gap-4 py-6 md:flex-row md:items-center md:justify-between">
            <div class="md:w-1/3"><h3 class="text-lg font-semibold">{t.name}</h3><p class="mt-1 text-sm text-muted">{t.features.join(" · ")}</p></div>
            <p class="font-heading text-3xl font-bold text-primary">{t.price}<span class="text-sm font-normal text-muted">{t.period}</span></p>
            <a href={href} class={btn(t)}>{t.cta}</a>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
