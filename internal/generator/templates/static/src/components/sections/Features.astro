---
import Img from "../Img.astro";
import Carousel from "../Carousel.astro";
const { data, layout = "grid" } = Astro.props;
---
<section id="features" class="px-6 py-20">
  <div class="mx-auto max-w-6xl">
    <div data-reveal class="mb-12 max-w-2xl">
      <h2 class="text-3xl font-bold md:text-4xl">{data.title}</h2>
      <p class="mt-3 text-muted">{data.subtitle}</p>
    </div>
    {layout === "grid" && (
      <div data-reveal class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {data.items.map((f, i) => (
          <div class="rounded-card border border-primary/10 p-6">
            <span class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-secondary/15 font-bold text-secondary">{i + 1}</span>
            <h3 class="text-lg font-semibold">{f.title}</h3>
            <p class="mt-2 text-sm text-muted">{f.text}</p>
          </div>
        ))}
      </div>
    )}
    {layout === "pointers-image" && (
      <div data-reveal class="grid items-center gap-12 md:grid-cols-2">
        <ul class="space-y-6">
          {data.items.map((f) => (
            <li class="border-l-4 border-secondary pl-4">
              <h3 class="text-lg font-semibold">{f.title}</h3>
              <p class="text-sm text-muted">{f.text}</p>
            </li>
          ))}
        </ul>
        <Img section="features" file={data.image} class="aspect-[4/3] w-full rounded-card" />
      </div>
    )}
    {layout === "carousel" && (
      <div data-reveal>
        <Carousel>
          {data.items.map((f) => (
            <div class="w-full shrink-0 snap-start rounded-card border border-primary/10 p-8 md:w-[calc(50%-12px)]">
              <h3 class="text-lg font-semibold">{f.title}</h3>
              <p class="mt-2 text-sm text-muted">{f.text}</p>
            </div>
          ))}
        </Carousel>
      </div>
    )}
  </div>
</section>
