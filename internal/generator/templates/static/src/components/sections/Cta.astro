---
import Button from "../Button.astro";
import site from "../../content/site.json";
const { data, layout = "banner" } = Astro.props;
---
{layout === "banner" ? (
  <section id="cta" class="bg-primary px-6 text-on-primary">
    <div data-reveal class="mx-auto max-w-3xl text-center">
      <h2 class="!text-on-primary">{data.title}</h2>
      <p class="mt-4 text-on-primary/80">{data.text}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {site.ctas.map((c, i) => (
          <a href={c.href} class={`rounded-btn px-6 py-3 text-sm font-semibold ${i === 0 ? "bg-secondary text-on-secondary" : "border border-on-primary/40 text-on-primary"}`}>{c.label}</a>
        ))}
      </div>
    </div>
  </section>
) : (
  <section id="cta" class="px-6">
    <div data-reveal class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 rounded-card border border-primary/10 bg-tertiary p-8 md:flex-row md:items-center md:p-14">
      <div class="max-w-xl"><h2>{data.title}</h2><p class="mt-3 text-muted">{data.text}</p></div>
      <div class="flex flex-wrap gap-3">{site.ctas.map((c) => <Button {...c} />)}</div>
    </div>
  </section>
)}
