---
import Img from "../Img.astro";
const { data, layout = "cards" } = Astro.props;
---
<section id="blog" class="px-6">
  <div class="mx-auto max-w-6xl">
    <h2 data-reveal class="mb-10 text-3xl font-bold md:text-4xl">{data.title}</h2>
    {layout === "cards" && (
      <div data-reveal class="grid gap-6 md:grid-cols-3">
        {data.items.map((b) => (
          <article>
            <Img section="blog" file={b.image} alt={b.title} class="aspect-[16/10] w-full rounded-card" />
            <p class="mt-4 text-xs uppercase tracking-wider text-secondary">{b.tag} · <span class="text-muted">{b.date}</span></p>
            <h3 class="mt-2 text-lg font-semibold">{b.title}</h3>
            <p class="mt-2 text-sm text-muted">{b.excerpt}</p>
            <a href="#" class="mt-3 inline-block text-sm font-semibold text-primary hover:text-secondary">Read more →</a>
          </article>
        ))}
      </div>
    )}
    {layout === "list" && (
      <div data-reveal class="divide-y divide-primary/10 border-y border-primary/10">
        {data.items.map((b) => (
          <article class="flex gap-5 py-6">
            <Img section="blog" file={b.image} alt={b.title} class="h-24 w-28 shrink-0 rounded-card sm:h-28 sm:w-40" />
            <div>
              <p class="text-xs uppercase tracking-wider text-secondary">{b.tag} · <span class="text-muted">{b.date}</span></p>
              <h3 class="mt-1 text-lg font-semibold">{b.title}</h3>
              <p class="mt-1 text-sm text-muted">{b.excerpt}</p>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>
