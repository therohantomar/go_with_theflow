---
import Img from "../Img.astro";
const { data, layout = "simple" } = Astro.props;
---
<section id="contact" class="px-6 py-16 md:py-20">
  <div data-reveal class={`mx-auto grid max-w-6xl gap-10 md:gap-12 md:grid-cols-2 ${layout === "split" ? "items-center" : ""}`}>
    {layout === "split" && <Img section="contact" file={data.image} class="aspect-[4/3] w-full rounded-card" />}
    <div class={layout === "split" ? "space-y-8" : "contents"}>
      <div>
        <h2 class="text-3xl font-bold md:text-4xl">{data.title}</h2>
        <p class="mt-3 text-muted">{data.text}</p>
        {layout === "simple" && (
          <ul class="mt-6 space-y-1 text-sm text-muted"><li>{data.email}</li><li>{data.phone}</li><li>{data.address}</li></ul>
        )}
      </div>
      <form class="space-y-4" onsubmit="return false">
        <input class="w-full rounded-field border border-primary/20 px-4 py-3" placeholder="Name" />
        <input class="w-full rounded-field border border-primary/20 px-4 py-3" type="email" placeholder="Email" />
        <textarea class="w-full rounded-field border border-primary/20 px-4 py-3" rows="4" placeholder="Message"></textarea>
        <button class="w-full rounded-btn bg-primary px-6 py-3 text-sm font-semibold text-on-primary sm:w-auto">Send</button>
      </form>
    </div>
  </div>
</section>
