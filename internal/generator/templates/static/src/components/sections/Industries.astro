---
const { data, layout = "chips" } = Astro.props;
---
<section id="industries" class="px-6 py-20">
  <div class="mx-auto max-w-6xl">
    <h2 data-reveal class="mb-10 text-3xl font-bold md:text-4xl">{data.title}</h2>
    {layout === "chips" && (
      <ul data-reveal class="flex flex-wrap gap-3">
        {data.items.map((i) => (
          <li class="flex items-center gap-2 rounded-full border border-primary/15 bg-tertiary px-5 py-3 text-sm font-semibold"><span>{i.icon}</span>{i.name}</li>
        ))}
      </ul>
    )}
    {layout === "cards" && (
      <ul data-reveal class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {data.items.map((i) => (
          <li class="rounded-2xl border border-primary/10 p-6"><span class="text-3xl">{i.icon}</span><p class="mt-3 font-semibold">{i.name}</p></li>
        ))}
      </ul>
    )}
  </div>
</section>
